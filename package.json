{
  "name": "escape-room",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "pnpm dlx firebase-tools@15.33.0 emulators:exec --only database --project demo-bureau-x \"vitest run tests/database-rules.test.ts\"",
    "test:e2e": "playwright test",
    "rookproef": "node --experimental-strip-types scripts/rookproef.ts",
    "lint:html": "html-validate \"*.html\" \"kamer-14/*.html\" \"dua/*.html\" \"experiences/**/*.html\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "~1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "html-validate": "^11.21.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@sentry/browser": "^11.6.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "firebase": "^12.19.0"
  }
}
