{
  "name": "escape-room",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "pnpm i18n && vite",
    "build": "pnpm i18n && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "pnpm dlx firebase-tools@15.33.0 emulators:exec --only database --project demo-bureau-x \"vitest run tests/database-rules.test.ts\"",
    "test:e2e": "playwright test",
    "test:opmaak": "playwright test --config e2e/config/playwright.opmaak.config.ts",
    "screenshots": "playwright test --config e2e/config/playwright.screenshots.config.ts",
    "i18n": "node --experimental-strip-types scripts/i18n.ts",
    "i18n:controle": "node --experimental-strip-types scripts/i18n.ts --controle",
    "i18n:bevestig": "node --experimental-strip-types scripts/i18n.ts --bevestig",
    "i18n:sleutels": "node --experimental-strip-types scripts/i18n-sleutels.ts",
    "rookproef": "node --experimental-strip-types scripts/rookproef.ts",
    "lint:html": "pnpm i18n && html-validate \"*.html\" \"kamer-14/*.html\" \"dua/*.html\" \"experiences/**/*.html\" \"en/**/*.html\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "~1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "html-validate": "^11.21.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@sentry/browser": "^11.13.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "firebase": "^13.3.0"
  }
}
