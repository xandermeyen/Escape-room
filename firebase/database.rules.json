{
  "rules": {
    "beheerders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "sessions": {
      ".read": "auth != null && root.child('beheerders').child(auth.uid).val() === true",
      "$sessie": {
        ".read": true,
        ".write": "auth != null && root.child('beheerders').child(auth.uid).val() === true",
        ".validate": "$sessie.matches(/^[A-Z0-9-]{3,20}$/) && (data.exists() || newData.hasChildren(['aangemaakt', 'actief', 'ervaringsId']))",
        "aangemaakt": {
          ".validate": "newData.isNumber()"
        },
        "actief": {
          ".write": "auth != null && newData.val() === false && root.child('sessions').child($sessie).child('aangemaakt').exists()",
          ".validate": "newData.isBoolean()"
        },
        "ervaringsId": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "aantalSpelers": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8"
        },
        "timerGestart": {
          ".write": "auth != null && !data.exists() && newData.val() === now && root.child('sessions').child($sessie).child('aangemaakt').exists()",
          ".validate": "newData.isNumber()"
        },
        "geopendOp": {
          ".write": "auth != null && !data.exists() && newData.val() === now && root.child('sessions').child($sessie).child('aangemaakt').exists()",
          ".validate": "newData.isNumber()"
        },
        "puzzels": {
          "$p": {
            ".write": "auth != null && newData.isBoolean() && (newData.val() === true || !data.exists() || data.val() === false) && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "$p.matches(/^p[0-5]$/) && newData.isBoolean()"
          }
        },
        "spelers": {
          "$rol": {
            ".write": "auth != null && !data.exists() && newData.val() === 'bezet' && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "$rol.matches(/^[a-z]{1,16}$/) && newData.isString() && newData.val().length <= 16"
          }
        },
        "rapport": {
          "ingediend": {
            ".write": "auth != null && data.val() !== true && newData.val() === true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.isBoolean()"
          },
          "tijdstip": {
            ".write": "auth != null && data.parent().child('ingediend').val() !== true && newData.val() === now && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.isNumber()"
          },
          "inhoud": {
            ".write": "auth != null && data.parent().child('ingediend').val() !== true && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            "$veld": {
              ".validate": "$veld.matches(/^(bestemming|wie|vervoer|tijdstip|conclusie)$/) && newData.isString() && newData.val().length <= 4000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "dua": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
          "p0zegel": {
            ".write": "auth != null && newData.val() === true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.isBoolean()"
          },
          "brief": {
            ".write": "auth != null && newData.exists() && root.child('sessions').child($sessie).child('puzzels').child('p1').val() !== true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.hasChildren(['letters', 'verstuurd'])",
            "letters": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9,]{0,32}$/)"
            },
            "verstuurd": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "kluisNummer": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}$/)"
          },
          "verstopPlek": {
            ".write": "auth != null && root.child('sessions').child($sessie).child('puzzels').child('p4').val() !== true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.isString() && newData.val().matches(/^(kast|bureau|schouw|boekenrek|vloerplank)$/)"
          },
          "pin1934": {
            ".write": "auth != null && root.child('sessions').child($sessie).child('puzzels').child('p5').val() !== true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.isString() && newData.val().matches(/^(sintbaafs|belfort|station|gravensteen|leie)$/)"
          },
          "brief14": {
            ".write": "auth != null && newData.exists() && data.child('klaar').val() !== true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.hasChildren(['tekst', 'klaar'])",
            "tekst": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "klaar": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "meta": {
            ".write": "auth != null && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
            ".validate": "newData.hasChildren(['verdenking', 'strafMs', 'hints'])",
            "verdenking": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "strafMs": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000 && (!data.exists() || newData.val() >= data.val() || root.child('beheerders').child(auth.uid).val() === true)"
            },
            "hints": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && (!data.exists() || newData.val() >= data.val() || root.child('beheerders').child(auth.uid).val() === true)"
            },
            "$other": {
              ".validate": false
            }
          },
          "badges": {
            "$badge": {
              ".write": "auth != null && newData.val() === true && root.child('sessions').child($sessie).child('aangemaakt').exists()",
              ".validate": "$badge.matches(/^[a-z0-9-]{1,32}$/) && newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "stats": {
          "$p": {
            ".validate": "$p.matches(/^p[0-5]$/)",
            "start": {
              ".write": "$p.matches(/^p[0-5]$/) && auth != null && !data.exists() && newData.val() === now && root.child('sessions').child($sessie).child('aangemaakt').exists()",
              ".validate": "newData.isNumber()"
            },
            "opgelost": {
              ".write": "$p.matches(/^p[0-5]$/) && auth != null && !data.exists() && newData.val() === now && root.child('sessions').child($sessie).child('aangemaakt').exists()",
              ".validate": "newData.isNumber()"
            },
            "fout": {
              ".write": "$p.matches(/^p[0-5]$/) && auth != null && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && (!data.exists() || newData.val() === data.val() + 1)"
            },
            "bijna": {
              ".write": "$p.matches(/^p[0-5]$/) && auth != null && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && (!data.exists() || newData.val() === data.val() + 1)"
            },
            "hints": {
              "$rol": {
                ".write": "$p.matches(/^p[0-5]$/) && auth != null && newData.exists() && root.child('sessions').child($sessie).child('aangemaakt').exists()",
                ".validate": "$rol.matches(/^[a-z0-9]{1,8}$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && (!data.exists() || newData.val() >= data.val())"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reviews": {
      ".read": "(query.orderByChild === 'goedgekeurd' && query.equalTo === true) || (auth != null && root.child('beheerders').child(auth.uid).val() === true)",
      ".indexOn": ["goedgekeurd"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['rating', 'tekst', 'ervaring', 'tijdstip'])",
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "tekst": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "naam": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "ervaring": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "tijdstip": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "goedgekeurd": {
          ".write": "auth != null && root.child('beheerders').child(auth.uid).val() === true",
          ".validate": "newData.isBoolean() && (newData.val() === false || root.child('beheerders').child(auth.uid).val() === true)"
        },
        "verbeter": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "verdeling": {
      "$ervaring": {
        ".read": true,
        ".write": "auth != null && root.child('beheerders').child(auth.uid).val() === true",
        ".validate": "$ervaring.matches(/^[a-z0-9-]{1,24}$/) && newData.hasChild('bijgewerkt')",
        "duren": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,5}$/) && newData.isNumber() && newData.val() > 0 && newData.val() <= 7200000"
          }
        },
        "bijgewerkt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
